  "Frontend": {
    "BaseUrl": "https://smartwash.zishot.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://smartwash.zishot.com"
    ]
  },
  "Diagnostics": {
    "ExposeErrorDetails": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    }
  },
  "Seed": {
    "RunOnStartup": false,
    "PlatformOwner": {
      "Email": "owner@smartwash.com",
      "Password": "REPLACE-WITH-PASSWORD-FROM-SECRET-STORE",
      "DisplayName": "مدیر سامانه"
    },
    "DemoTenant": {
      "Enabled": true,
      "Slug": "demo-carwash",
      "DisplayName": "کارواش آزمایشی SmartWash",
      "Email": "demo@smartwash.com",
      "Password": "REPLACE-WITH-PASSWORD-FROM-SECRET-STORE",
      "OwnerDisplayName": "مدیر کارواش آزمایشی",
      "Phone": "09120000000"
    }
  },
  "Payments": {
    "Default": "Zarinpal",
    "Zarinpal": {
      "Enabled": true,
