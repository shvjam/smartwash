    "IdPay": {
      "Enabled": false,
      "ApiKey": "REPLACE-WITH-API-KEY-FROM-SECRET-STORE"
    }
  },
  "Sms": {
    "Enabled": true,
    "Provider": "sms.ir",
    "ApiKey": "REPLACE-WITH-API-KEY-FROM-SECRET-STORE",
    "Templates": {
