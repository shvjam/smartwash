<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<location path="." inheritInChildApplications="false">
		<system.webServer>
			<modules>
				<!-- WebDAV می‌تواند درخواست‌های OPTIONS/PUT/DELETE را قبل از رسیدن به اپ بقاپد و CORS را بشکند -->
				<remove name="WebDAVModule" />
			</modules>
			<handlers>
				<!-- OPTIONSVerbHandler و WebDAV نباید preflightِ CORS را پاسخ دهند؛ همه‌چیز به ASP.NET Core برود -->
				<remove name="OPTIONSVerbHandler" />
				<remove name="WebDAV" />
				<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
			</handlers>
			<aspNetCore processPath="dotnet"
						arguments=".\SmartWash.Api.dll"
						stdoutLogEnabled="true"
						stdoutLogFile=".\App_Data\logs\stdout"
						hostingModel="inprocess">
				<environmentVariables>
					<!-- Production must not expose Swagger or ASP.NET Core exception details.
               Secrets are injected at the host level (IIS/Plesk environment variables),
               never committed in this file. -->
					<environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
					<environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="false" />
					<environmentVariable name="COMPlus_EnableDiagnostics" value="0" />
				</environmentVariables>
			</aspNetCore>
			<httpProtocol>
				<customHeaders>
					<add name="X-Content-Type-Options" value="nosniff" />
					<add name="X-Frame-Options" value="DENY" />
					<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
					<add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
				</customHeaders>
			</httpProtocol>
			<security>
				<requestFiltering>
					<requestLimits maxAllowedContentLength="20971520" />
					<!-- App_Data به‌طور پیش‌فرض در hiddenSegments سطح سرور تعریف شده؛
               تکرار آن باعث خطای 500.19 (duplicate segment) می‌شود، پس اینجا اضافه نمی‌کنیم. -->
				</requestFiltering>
			</security>
			<staticContent>
				<remove fileExtension=".webp" />
				<mimeMap fileExtension=".webp" mimeType="image/webp" />
			</staticContent>
		</system.webServer>
	</location>
</configuration>
