{
  "ConnectionStrings": {
    "Default": "REPLACE-WITH-SECURE-CONNECTION-STRING"
  },
  "Jwt": {
    "Issuer": "api.appsmartwash.com",
    "Audience": "appsmartwash.com",
    "SigningKey": "REPLACE-WITH-64-CHARACTER-MINIMUM-JWT-SIGNING-KEY-FROM-SECRET-STORE",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "ClockSkewSeconds": 30
  },
  "Cron": {
    "Secret": "REPLACE-WITH-HIGH-ENTROPY-CRON-SECRET-FROM-SECRET-STORE"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Otlp": {
    "Endpoint": ""
  },
  "Storage": {
    "Local": {
      "RootPath": "App_Data/uploads",
      "PublicBaseUrl": "/uploads"
    }
  },
  "Seed": {
    "RunOnStartup": false,
    "PlatformOwner": {
      "Email": "owner@smartwash.com",
      "Password": "REPLACE-WITH-PASSWORD-FROM-SECRET-STORE",
      "DisplayName": "مدیر سامانه"
    },
    "DemoTenant": {
      "Enabled": true,
      "Slug": "demo-carwash",
      "DisplayName": "کارواش آزمایشی SmartWash",
      "Email": "demo@smartwash.com",
      "Password": "REPLACE-WITH-PASSWORD-FROM-SECRET-STORE",
      "OwnerDisplayName": "مدیر کارواش آزمایشی",
      "Phone": "09120000000"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/smartwash-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 20971520,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Payments": {
    "Zarinpal": {
      "MerchantId": "REPLACE-WITH-ZARINPAL-MERCHANT-ID",
      "BaseUrl": "https://payment.zarinpal.com/pg/v4/payment/",
      "StartPayUrl": "https://payment.zarinpal.com/pg/StartPay/",
      "Sandbox": false
    },
    "IDPay": {
      "ApiKey": "REPLACE-WITH-API-KEY-FROM-SECRET-STORE",
      "BaseUrl": "https://api.idpay.ir/v1.1/payment",
      "Sandbox": false
    },
    "NextPay": {
      "ApiKey": "REPLACE-WITH-API-KEY-FROM-SECRET-STORE",
      "BaseUrl": "https://nextpay.org/nx/gateway/token",
      "VerifyUrl": "https://nextpay.org/nx/gateway/verify",
      "StartPayUrl": "https://nextpay.org/nx/gateway/payment/"
    }
  },
  "Sms": {
    "ApiKey": "REPLACE-WITH-API-KEY-FROM-SECRET-STORE",
    "Sender": "30007732",
    "BaseUrl": "https://api.sms.ir/v1/",
    "Enabled": false,
    "TimeoutSeconds": 15,
    "Templates": {
      "OtpLogin": 0,
      "PasswordReset": 0,
      "OrderReady": 0,
      "ReservationConfirmed": 0,
      "ReservationReminder": 0,
      "NextWashReminder": 0,
      "Campaign": 0,
      "BillingReminder": 0,
      "BillingPastDue": 0,
      "BillingSuspended": 0
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "REPLACE-WITH-PASSWORD-FROM-SECRET-STORE",
    "FromAddress": "no-reply@appsmartwash.com",
    "FromName": "SmartWash",
    "EnableSsl": true,
    "Enabled": false
  },
  "AllowedHosts": "*"
}
