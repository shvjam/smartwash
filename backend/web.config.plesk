<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath=".\SmartWash.Api.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\App_Data\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="false" />
        </environmentVariables>
      </aspNetCore>

      <!-- Plesk points 4xx/5xx at its own HTML error pages. For an API that is wrong:
           IIS would swap our JSON error body for an HTML page and the SPA would parse
           the wrong thing. PassThrough keeps the response the application produced. -->
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
