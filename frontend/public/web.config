<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the SmartWash SPA (frontend) hosted on Plesk/Windows.
  Vite copies everything under public/ to the build output root (dist/),
  so this ends up next to index.html after `pnpm build`.

  Without this, IIS serves paths like /register or /platform/login as static
  files, and since those files do not exist you get "HTTP Error 404.0 - Not Found".
  The rewrite rule falls all non-file, non-API routes back to index.html so the
  React router can handle them.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Do not rewrite real files (js/css/png/…) -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- Do not rewrite real directories -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <!-- Ensure correct MIME types for common SPA assets -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- The landing photos are WebP, which older IIS versions do not know. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
