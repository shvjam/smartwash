# Build outputs are reproducible; never commit them.
**/bin/
**/obj/
publish/
api-root/
*.publish.zip
node_modules/
dist/
build/

# Runtime data written by the API on the host: logs and tenant uploads.
# App_Data/.gitkeep is tracked so the directory survives a clean checkout.
**/App_Data/logs/
**/App_Data/uploads/
*.log

# Secrets are injected as host environment variables, never committed.
.env*
web.config.filled
cron-bat/
*.pfx
secrets.json

# Editor / OS noise
.vs/
.idea/
*.user
Thumbs.db
desktop.ini

# Server files downloaded for diagnosis — may contain host config and paths.
files on server/
remote-listing.txt
